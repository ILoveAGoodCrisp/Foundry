class TagFile:
    """An open tag file — the root handle of the facade.

    Load one with [`TagFile.read`] (or [`TagFile.read_from_bytes`]), reach the
    top of the tag tree with [`TagFile.root`], edit through the returned
    [`TagStruct`] / [`TagField`] / [`TagBlock`] handles, then persist with
    [`TagFile.write`]. A tag may also carry separate dependency-list,
    import-info, and asset-depot-storage structs, reached with
    [`TagFile.dependency_list`] and friends. Every handle borrows this file, so
    a structural edit (adding/removing block elements) invalidates outstanding
    handles; re-fetch them after mutating a block."""
    @staticmethod
    def new(schema_path: str | os.PathLike[str]) -> TagFile:
        """Create a fresh tag from a JSON schema, with one default root element."""
        ...
    @staticmethod
    def new_classic(schema_path: str | os.PathLike[str], game: str) -> TagFile:
        """Create a fresh Halo CE or Halo 2 loose tag from an external JSON schema."""
        ...
    @staticmethod
    def read(path: str | os.PathLike[str]) -> TagFile:
        """Read and fully parse the tag file at `path`."""
        ...
    @staticmethod
    def read_classic(path: str | os.PathLike[str], schema_path: str | os.PathLike[str]) -> TagFile:
        """Read a classic Halo CE / Halo 2 tag using its external JSON schema."""
        ...
    @staticmethod
    def read_from_bytes(bytes: bytes) -> TagFile:
        """Parse a complete tag file already held in memory."""
        ...
    @staticmethod
    def read_dependency_references(path: str | os.PathLike[str]) -> list[tuple[int, str]] | None:
        """Read just the dependency references from the tag at `path`, without
        parsing the whole file. Returns `None` if the tag carries no
        dependency-list stream."""
        ...
    def write(self, path: str | os.PathLike[str]) -> None:
        """Serialize to `path`."""
        ...
    def write_atomic(self, path: str | os.PathLike[str]) -> None:
        """Serialize to `path` via a temporary file and a rename."""
        ...
    def write_to_bytes(self) -> bytes:
        """Serialize to a `bytes` object."""
        ...
    def bitmap_tiff(self, index: int) -> bytes:
        """Decode one bitmap image and return a complete RGBA TIFF file."""
        ...
    def particle_meshes(self, stem: str) -> list[dict[str, object]]:
        """Detached particle meshes: world-unit positions, unflipped UVs and triangle indices."""
        ...
    def physics_shapes_h2(self) -> list[dict[str, object]]:
        """Detached Halo 2 physics primitives decoded by the classic JMS path."""
        ...
    def render_model_meshes(self) -> list[dict[str, object]]:
